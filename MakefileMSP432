# ==============================================================
# Directories
# ==============================================================
ARM_TOOLCHAIN_DIR  = /c/ti/gcc_arm_none_eabi_9_2_1
ARM_BIN_DIR        = $(ARM_TOOLCHAIN_DIR)/bin
SDK_DIR            = /c/ti/simplelink_msp432p4_sdk_3_40_01_02
DRIVERLIB_DIR      = $(SDK_DIR)/source/ti/devices/msp432p4xx/driverlib
CMSIS_DIR          = $(SDK_DIR)/source/third_party/CMSIS/Include
OPENOCD_DIR        = /c/ti/openocd
OPENOCD_BIN_DIR    = $(OPENOCD_DIR)/bin
OPENOCD_SCRIPTS    = $(OPENOCD_DIR)/share/openocd/scripts
BUILD_DIR          = build
OBJ_DIR            = $(BUILD_DIR)/obj
BIN_DIR            = $(BUILD_DIR)/bin

# ==============================================================
# Toolchain
# ==============================================================
CC      = $(ARM_BIN_DIR)/arm-none-eabi-gcc.exe
GDB     = $(ARM_BIN_DIR)/arm-none-eabi-gdb.exe
OBJCOPY = $(ARM_BIN_DIR)/arm-none-eabi-objcopy.exe
RM      = rm

# ==============================================================
# Files
# ==============================================================
TARGET = $(BIN_DIR)/blink

DRIVERLIB_SRCS = gpio.c wdt_a.c interrupt.c cs.c pcm.c \
                 sysctl.c flash.c flash_a.c systick.c \
                 timer_a.c timer32.c uart.c spi.c i2c.c \
                 adc14.c dma.c cpu.c fpu.c reset.c \
                 comp_e.c crc32.c aes256.c pmap.c \
                 pss.c ref_a.c rtc_c.c mpu.c

DRIVERLIB_OBJECTS = $(patsubst %.c,$(OBJ_DIR)/driverlib/%.o,$(DRIVERLIB_SRCS))

OBJECTS = $(OBJ_DIR)/src/main.o \
          $(OBJ_DIR)/src/led.o \
          $(OBJ_DIR)/src/grove/grove_buzzer.o \
          $(OBJ_DIR)/src/startup_msp432p401r_gcc.o \
          $(OBJ_DIR)/src/system_msp432p401r.o \
          $(DRIVERLIB_OBJECTS)

# ==============================================================
# Flags
# ==============================================================
WFLAGS = -Wall -Wextra -Werror -Wshadow

CFLAGS  = -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard
CFLAGS += $(WFLAGS) -Og -g
CFLAGS += -ffunction-sections -fdata-sections
CFLAGS += -D__MSP432P401R__
CFLAGS += -I$(SDK_DIR)/source
CFLAGS += -I$(DRIVERLIB_DIR)
CFLAGS += -I$(CMSIS_DIR)

DRIVERLIB_CFLAGS  = -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard
DRIVERLIB_CFLAGS += -Wall -Og -g
DRIVERLIB_CFLAGS += -ffunction-sections -fdata-sections
DRIVERLIB_CFLAGS += -D__MSP432P401R__
DRIVERLIB_CFLAGS += -I$(SDK_DIR)/source
DRIVERLIB_CFLAGS += -I$(DRIVERLIB_DIR)
DRIVERLIB_CFLAGS += -I$(CMSIS_DIR)

LDFLAGS = -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard --specs=nosys.specs -Wl,-T,$(SDK_DIR)/source/ti/devices/msp432p4xx/linker_files/gcc/msp432p401r.lds --entry ResetISR -Wl,--gc-sections -Wl,--print-memory-usage

# ==============================================================
# Build rules
# ==============================================================
$(OBJ_DIR)/src/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $

$(OBJ_DIR)/driverlib/%.o: $(DRIVERLIB_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(DRIVERLIB_CFLAGS) -c -o $@ $

$(TARGET).elf: $(OBJECTS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) $^ -o $@

$(TARGET).bin: $(TARGET).elf
	$(OBJCOPY) -O binary $< $@

# ==============================================================
# Phonies
# ==============================================================
.PHONY: all clean flash debug

all: $(TARGET).elf $(TARGET).bin

clean:
	$(RM) -rf $(BUILD_DIR)

flash: $(TARGET).elf
	@taskkill //F //IM openocd.exe 2>/dev/null || true
	@echo "Flashing $(TARGET).elf ..."
	$(OPENOCD_BIN_DIR)/openocd.exe \
		-s "$(OPENOCD_SCRIPTS)" \
		-f interface/xds110.cfg \
		-f target/ti_msp432.cfg \
		-c "adapter speed 500" \
		-c "program $(TARGET).elf verify reset exit"
	@echo "Flash complete!"

debug: $(TARGET).elf
	@taskkill //F //IM openocd.exe 2>/dev/null || true
	@echo "Starting OpenOCD GDB server on :3333 ..."
	@$(OPENOCD_BIN_DIR)/openocd.exe \
		-s "$(OPENOCD_SCRIPTS)" \
		-f interface/xds110.cfg \
		-f target/ti_msp432.cfg \
		-c "adapter speed 500" &
	@sleep 2
	$(GDB) \
		-ex "target remote localhost:3333" \
		-ex "monitor reset halt" \
		$(TARGET).elf